{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soundscape.local/schemas/scene.schema.json",
  "title": "Soundscape static scene asset manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "status", "tags", "audioLayers", "visualBrief", "slots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["starter", "planned", "ready"] },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "audioLayers": { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true },
    "visualBrief": { "type": "string", "minLength": 1 },
    "slots": {
      "type": "object",
      "required": ["hero", "banner", "cover", "thumbnail", "detail"],
      "additionalProperties": false,
      "properties": {
        "hero": { "$ref": "#/$defs/slot" },
        "banner": { "$ref": "#/$defs/slot" },
        "cover": { "$ref": "#/$defs/slot" },
        "thumbnail": { "$ref": "#/$defs/slot" },
        "detail": { "$ref": "#/$defs/slot" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["status", "assetId"],
      "properties": {
        "status": { "enum": ["planned", "shared-fallback", "ready"] },
        "assetId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
